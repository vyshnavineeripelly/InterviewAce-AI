PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Replace the placeholders locally. Never commit a real password.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/interviewace?retryWrites=true&w=majority

# Long random string. Generate one locally; never commit the real value.
JWT_SECRET=<jwt_secret>
JWT_EXPIRES_IN=7d

# LLM is called only from Express. Leave placeholders until you configure a key locally.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=<ai_api_key>
AI_BASE_URL=
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=2

